{
  "name": "@akshatmittal/invoker",
  "version": "0.1.0",
  "description": "Typed matrix-driven regression workflows for Vitest.",
  "keywords": [
    "matrix",
    "regression",
    "vitest",
    "workflow"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akshatmittal/invoker.git"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./github": {
      "types": "./dist/github.d.mts",
      "import": "./dist/github.mjs"
    },
    "./slack": {
      "types": "./dist/slack.d.mts",
      "import": "./dist/slack.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@octokit/auth-app": "^8.3.0",
    "@octokit/request": "^10.0.13",
    "@slack/web-api": "^8.0.0",
    "@types/node": "catalog:",
    "@workspace/tsconfig": "workspace:*",
    "croner": "^10.0.1",
    "evlog": "^2.26.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@octokit/auth-app": "^8.3.0",
    "@octokit/request": "^10.0.13",
    "@slack/web-api": "^8.0.0",
    "croner": "^10.0.1",
    "evlog": "^2.26.0",
    "vitest": "^4.1.10"
  },
  "peerDependenciesMeta": {
    "@octokit/auth-app": {
      "optional": true
    },
    "@octokit/request": {
      "optional": true
    },
    "@slack/web-api": {
      "optional": true
    },
    "croner": {
      "optional": true
    },
    "evlog": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.18.1"
  }
}
