{
  "name": "@workspace/oxlint-anti-slop",
  "version": "0.0.0",
  "private": true,
  "description": "Opinionated Oxlint rules that reject low-evidence TypeScript patterns.",
  "keywords": [
    "lint",
    "oxlint",
    "plugin",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akshatmittal/invoker.git",
    "directory": "packages/anti-slop"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@workspace/tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@oxlint/plugins": "^1.78.0"
  },
  "engines": {
    "node": "^24.18.1"
  }
}
